{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "cd frontend && npm run dev -- --port 5180 --strictPort"],
      "port": 5180
    },
    {
      "name": "frontend-live-api",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "--port", "5181", "--strictPort"],
      "cwd": "frontend",
      "env": { "VITE_API_BASE_URL": "https://api.dalloyou.com/api" },
      "port": 5181
    },
    {
      "name": "frontend-built",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "preview", "--", "--port", "5182", "--strictPort"],
      "cwd": "frontend",
      "port": 5182
    }
  ]
}
